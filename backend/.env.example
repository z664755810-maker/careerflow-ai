# ===== CareerFlow AI 环境变量样例 =====
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）

# --- 数据库 ---
# 本地开发（默认，零依赖）：
# DATABASE_URL=sqlite+aiosqlite:///./careerflow.db
# 生产（Render + Postgres）：
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/careerflow

# --- JWT ---
# 生产务必改成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM（OpenAI 兼容，key 只走环境变量）---
# 推荐（部署稳定）：阿里云百炼 dashscope（通义千问），规避智谱免费档 429
# 注册 https://dashscope.console.aliyun.com 获取 key
# LLM_API_KEY=sk-你的dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# 备选：智谱 glm-4-flash（免费，但免费档偶有 429）
# LLM_API_KEY=你的智谱key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 如需用 DeepSeek（余额充足时）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- 应用 ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 自动 seed（Render 临时文件系统重启丢库时灌演示数据）---
# 设为 0 可关闭；默认开启（仅当数据库为空时灌入，已有数据不覆盖）
AUTO_SEED=1
DEMO_PASSWORD=CareerFlow2026
