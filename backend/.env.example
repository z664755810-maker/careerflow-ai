# ===== CareerFlow AI 环境变量样例 =====
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）

# --- 数据库 ---
# 本地开发（默认，零依赖）：
# DATABASE_URL=sqlite+aiosqlite:///./careerflow.db
# 生产（Render + Postgres）：
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/careerflow

# --- JWT ---
# 生产务必改成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM（OpenAI 兼容，key 只走环境变量）---
# 推荐：智谱 glm-4-flash（免费）
# 注册 https://open.bigmodel.cn 获取 key
LLM_API_KEY=your-zhipu-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
# 如需用 DeepSeek（余额充足时）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- 应用 ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
